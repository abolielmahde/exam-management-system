digraph G {
  graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.8, ranksep=0.8];
  node [shape=record, style="filled", fontname="DejaVu Sans", fontsize=10.5, fillcolor="#f8fafc", color="#475569", penwidth=1.4];
  edge [fontname="DejaVu Sans", fontsize=10, color="#334155", penwidth=1.3, arrowsize=0.8];
  users [label="{USERS|id PK\l|full_name\l|email UNIQUE\l|password_hash\l|role CHECK\l|created_at\l}", fillcolor="#dbeafe", color="#2563eb"];
  exams [label="{EXAMS|id PK\l|teacher_id FK → users.id\l|title\l|course\l|description\l|duration_minutes\l|status CHECK\l|questions JSONB\l|created_at\l|updated_at\l}", fillcolor="#f3e8ff", color="#7c3aed"];
  submissions [label="{SUBMISSIONS|id PK\l|exam_id FK → exams.id\l|student_id FK → users.id\l|answers JSONB\l|grade CHECK 0..100\l|feedback\l|is_published\l|submitted_at\l|updated_at\l|UNIQUE(exam_id, student_id)\l}", fillcolor="#ecfdf5", color="#059669"];
  users -> exams [label="1 teacher creates N exams", arrowhead=crow, dir=both, arrowtail=tee];
  users -> submissions [label="1 student submits N", arrowhead=crow, dir=both, arrowtail=tee];
  exams -> submissions [label="1 exam receives N submissions", arrowhead=crow, dir=both, arrowtail=tee];
}
