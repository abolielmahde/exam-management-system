digraph G {
  graph [rankdir=TB, bgcolor="white", pad=0.25, nodesep=0.45, ranksep=0.65];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=11, fillcolor="#f8fafc", color="#64748b", penwidth=1.3];
  edge [color="#475569", penwidth=1.2, arrowsize=0.75];
  app [label="App.jsx\nRouting + Global State", fillcolor="#dbeafe", color="#2563eb"];
  nav [label="Shared Components\nNavigationMenu • Toast"];
  pages [label="Pages\nAuth • Teacher • Student", fillcolor="#eef2ff", color="#4f46e5"];
  services [label="Services\nApi • Auth • Storage • Logger • Notify • Config", fillcolor="#f3e8ff", color="#7c3aed"];
  models [label="OOP Models\nUser • Exam • Submission", fillcolor="#ecfdf5", color="#059669"];
  styles [label="Styles\nmain.css"];
  api [label="Backend REST API", fillcolor="#fff7ed", color="#ea580c"];
  local [label="localStorage\nToken + Current User", fillcolor="#fff7ed", color="#ea580c"];
  app -> nav;
  app -> pages;
  pages -> services;
  pages -> models [style=dashed];
  pages -> styles [style=dashed];
  services -> api [label="fetch / JSON"];
  services -> local [label="session"];
}
