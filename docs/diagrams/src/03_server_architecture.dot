digraph G {
  graph [rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.5, ranksep=0.65];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=11, fillcolor="#f8fafc", color="#64748b", penwidth=1.3];
  edge [color="#475569", penwidth=1.2, arrowsize=0.75];
  server [label="server.js\nExpress Bootstrap", fillcolor="#dbeafe", color="#2563eb"];
  middleware [label="Global Middleware\nHelmet • CORS • JSON • Morgan", fillcolor="#eef2ff", color="#4f46e5"];
  routes [label="Routes\nAuth • Exams • Submissions • Analytics", fillcolor="#f3e8ff", color="#7c3aed"];
  auth [label="Security Middleware\nrequireAuth • requireRole"];
  utils [label="Utilities\nValidators • Grading • Mappers"];
  db [label="DB Layer\nPool • initDatabase", fillcolor="#ecfdf5", color="#059669"];
  pg [label="PostgreSQL", shape=cylinder, fillcolor="#ecfdf5", color="#059669"];
  errors [label="Error Handling\n404 + centralized handler"];
  server -> middleware -> routes;
  routes -> auth;
  routes -> utils;
  routes -> db;
  db -> pg;
  routes -> errors [style=dashed];
}
